{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(rm *)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npm audit:*)",
      "Bash(npx vitest run:*)",
      "Bash(python3 tools/env_inspect.py:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh workflow run:*)",
      "Bash(npm publish:*)",
      "Bash(uv publish:*)",
      "Bash(docker push:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(gcloud run deploy:*)",
      "Bash(gcloud sql:*)",
      "Bash(gcloud iam:*)",
      "Bash(gcloud secrets:*)",
      "Bash(aws:*)",
      "Bash(firebase deploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(railway up:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/service-account*.json)",
      "Read(**/*credentials.json)"
    ]
  },
  "env": {
    "HARNESS_PROTECTED_BRANCHES": "main",
    "HARNESS_MERGE_ONLY_BRANCHES": "develop",
    "HARNESS_CONVENTIONAL_COMMITS": "1",
    "HARNESS_BLOCK_AI_TRAILERS": "0",
    "HARNESS_RM_PROTECTED": "src,.git,.claude,docs,migrations"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit_guard.py",
            "statusMessage": "Checking commit hygiene..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rm_guard.py",
            "statusMessage": "Checking delete targets..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secret_file_guard.py",
            "statusMessage": "Checking access to secret files..."
          }
        ]
      }
    ]
  }
}
